# Spring Boot API (used by Next.js rewrites and RSC fetches)

API_ORIGIN=http://localhost:8080



# Optional first admin (created on API startup only if no admin exists)

# ADMIN_EMAIL=you@example.com

# ADMIN_PASSWORD=your-password

# ADMIN_NAME=Your Name



# Claude resume extraction (optional; heuristic fallback when unset)

# Set on the Spring Boot process (backend terminal), not only in Next.js .env.local

# ANTHROPIC_API_KEY=

# ANTHROPIC_MODEL=claude-sonnet-4-6



# Optional public URL used in docs and email links

# NEXT_PUBLIC_APP_URL=http://localhost:3000

# APP_FRONTEND_URL=http://localhost:3000



# Gmail SMTP — set these on the Spring Boot process (backend terminal), not only in Next.js.

# Use a Gmail App Password with NO spaces (e.g. udskavyxfjvwpokd, not "udsk avyx fjvw pokd").

# MAIL_ENABLED=true

# MAIL_USERNAME=praneethnainala07@gmail.com

# MAIL_APP_PASSWORD=udsk avyx fjvw pokd



# Google sign-in — create a Web OAuth client in Google Cloud Console.

# Paste the same Web client ID in BOTH places below.

# Backend: set GOOGLE_CLIENT_ID on the Spring Boot terminal (or use default in application.yml).

# Frontend: copy to .env.local and restart npm run dev.

#

# Google Cloud → Authorized JavaScript origins (required):

#   http://localhost:3000

#   http://127.0.0.1:3000

# If you open the app via the Next.js Network URL (e.g. http://172.26.16.1:3000),

# add that exact origin too — otherwise Google Sign-In shows:

#   "The given origin is not allowed for the given client ID."

#

GOOGLE_CLIENT_ID="371497904463-hnd22p0e4119mjo6ta7b7r5lf08k9p5n.apps.googleusercontent.com"

NEXT_PUBLIC_GOOGLE_CLIENT_ID="371497904463-hnd22p0e4119mjo6ta7b7r5lf08k9p5n.apps.googleusercontent.com"

