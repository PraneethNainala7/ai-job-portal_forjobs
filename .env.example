# Spring Boot API (used by Next.js rewrites and RSC fetches)
API_ORIGIN=http://localhost:8080

# Optional first admin (created on API startup only if no admin exists)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=your-password
# ADMIN_NAME=Your Name

# Claude resume analysis and job ranking (optional; heuristic fallback if unset)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional public URL used in docs and future absolute links
# NEXT_PUBLIC_APP_URL=http://localhost:3000
